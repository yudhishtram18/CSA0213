function AuthCard() {
  const [mode, setMode] = useState<"signin" | "signup">("signin");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [busy, setBusy] = useState(false);

  async function submit(e: FormEvent) {
    e.preventDefault();
    setBusy(true);
    const result = mode === "signin"
      ? await supabase.auth.signInWithPassword({ email, password })
      : await supabase.auth.signUp({ email, password, options: { emailRedirectTo: window.location.origin } });
    setBusy(false);
    if (result.error) toast.error(result.error.message);
    else if (mode === "signup") toast.success("Check your email to confirm your account.");
  }

  async function social(provider: "google" | "lovable") {
    const result = await lovable.auth.signInWithOAuth(provider, { redirect_uri: window.location.origin });
    if (result.error) toast.error("Sign-in could not be completed.");
  }

  return (
    <div className="glass rounded-3xl p-6 text-left">
      <h2 className="text-xl font-semibold">{mode === "signin" ? "Welcome back" : "Create your account"}</h2>
      <form onSubmit={submit} className="mt-5 space-y-3">
        <Input required type="email" placeholder="Email address" value={email} onChange={(e) => setEmail(e.target.value)} />
        <Input required minLength={6} type="password" placeholder="Password" value={password} onChange={(e) => setPassword(e.target.value)} />
        <Button className="w-full" disabled={busy}>{busy ? "Please wait…" : mode === "signin" ? "Sign in" : "Sign up"}</Button>
      </form>
      <div className="my-4 text-center text-xs text-muted-foreground">or</div>
      <div className="grid gap-2">
        <Button type="button" variant="outline" onClick={() => social("google")}><GoogleMark />Continue with Google</Button>
        <Button type="button" variant="outline" onClick={() => social("lovable")}><LovableMark />Continue with Lovable</Button>
      </div>
      <button type="button" className="mt-4 w-full text-sm text-muted-foreground hover:text-foreground" onClick={() => setMode(mode === "signin" ? "signup" : "signin")}>
        {mode === "signin" ? "New here? Create an account" : "Already have an account? Sign in"}
      </button>
    </div>
  );
}

function Dashboard({ session }: { session: Session }) {
  const [month, setMonth] = useState(currentMonth());
  const [entries, setEntries] = useState<Entry[]>([]);
  const [budgets, setBudgets] = useState<CategoryBudget[]>([]);
  const [filter, setFilter] = useState<"all" | "expense" | "income">("all");
  const [query, setQuery] = useState("");

  async function load() {
    const start = `${month}-01`;
    const [y = 1970, m = 1] = month.split("-").map(Number);
    const end = new Date(y, m, 1).toISOString().slice(0, 10);
    const [tx, bg] = await Promise.all([
      supabase.from("transactions").select("*").gte("occurred_on", start).lt("occurred_on", end).order("occurred_on", { ascending: false }),
      supabase.from("budgets").select("id, category, monthly_limit").eq("month", start).order("category"),
    ]);
    if (tx.error || bg.error) toast.error("Your dashboard could not load.");
    else { setEntries(tx.data); setBudgets(bg.data); }
  }

  useEffect(() => { void load(); }, [month]);

  const expenses = sumKind(entries, "expense");
  const income = sumKind(entries, "income");
  const statuses = budgets.map((budget) => ({ ...budget, ...getBudgetStatus(entries, budget) }));
  const warnings = statuses.filter((item) => item.warning);
  const shown = entries.filter((e) => (filter === "all" || e.kind === filter) && `${e.title} ${e.category}`.toLowerCase().includes(query.toLowerCase()));
  const chart = useMemo(() => getDailySpending(entries, month).filter((d) => d.day % 3 === 1 || d.amount > 0), [entries, month]);

  async function remove(id: string) {
    const { error } = await supabase.from("transactions").delete().eq("id", id);
    if (error) toast.error("Could not delete it.");
    else { toast.success("Transaction deleted."); void load(); }
  }

  async function signOut() { await supabase.auth.signOut(); }

  return (
    <main className="min-h-screen bg-background text-foreground">
      <div className="hero-glow opacity-60" />
      <div className="relative z-10 mx-auto max-w-7xl p-4 md:p-8">
        <header className="glass flex flex-wrap items-center gap-4 rounded-3xl px-5 py-4">
          <Brand />
          <div className="relative order-3 w-full md:order-none md:ml-8 md:w-80">
            <Search className="absolute left-3 top-2.5 size-4 text-muted-foreground"/>
            <Input aria-label="Search transactions" className="pl-9" value={query} onChange={(e) => setQuery(e.target.value)} placeholder="Search transactions"/>
          </div>
          <div className="ml-auto flex items-center gap-3">
            <span className="relative icon-mini">
              <Bell/>
              {warnings.length > 0 && <i className="absolute -right-1 -top-1 size-2.5 rounded-full bg-warning"/>}
            </span>
            <span className="hidden text-sm sm:block">Hi, {session.user.email?.split("@")[0]}</span>
            <Button size="icon" variant="ghost" aria-label="Sign out" onClick={signOut}><LogOut/></Button>
          </div>
        </header>

        <div className="mt-6 grid gap-6 lg:grid-cols-[72px_1fr]">
          <aside className="glass hidden h-fit flex-col items-center gap-3 rounded-3xl p-3 lg:flex">
            {[LayoutDashboard, ReceiptText, Target, WalletCards].map((I, i) => (
              <span key={i} className={i === 0 ? "icon-mini active" : "icon-mini"}><I/></span>
            ))}
          </aside>
          <section>
            <div className="flex flex-wrap items-end justify-between gap-4">
              <div>
                <p className="text-sm text-primary">Monthly overview</p>
                <h1 className="mt-1 text-3xl font-semibold md:text-4xl">My Dashboard</h1>
              </div>
              <div className="flex gap-2">
                <Input aria-label="Month" type="month" value={month} onChange={(e) => setMonth(e.target.value)} className="w-40"/>
                <TransactionDialog onSaved={load}/>
              </div>
            </div>

            {warnings.length > 0 && (
              <div className="mt-6 flex items-start gap-3 rounded-2xl border border-warning/40 bg-warning/10 p-4 text-sm">
                <AlertTriangle className="mt-0.5 size-5 text-warning"/>
                <div><b>Budget warning:</b> {warnings.map((w) => `${w.category} is ${Math.round(w.ratio * 100)}% used`).join(", ")}.</div>
              </div>
            )}

            <div className="mt-6 grid gap-4 md:grid-cols-3">
              <Stat icon={ArrowDownLeft} label="Total spent" value={money(expenses)} note={`${entries.filter(e=>e.kind==="expense").length} expenses`} />
              <Stat icon={ArrowUpRight} label="Income" value={money(income)} note="This month" />
              <Stat icon={WalletCards} label="Net balance" value={money(income - expenses)} note={income >= expenses ? "You are on track" : "Spending exceeds income"} />
            </div>

            <div className="mt-6 grid gap-6 xl:grid-cols-[1.45fr_1fr]">
              <Panel title="Spending flow" action={<span className="text-xs text-muted-foreground">Daily expenses</span>}>
                <div className="h-72">
                  <ResponsiveContainer width="100%" height="100%">
                    <BarChart data={chart}>
                      <XAxis dataKey="day" tickLine={false} axisLine={false} stroke="var(--muted-foreground)" fontSize={12}/>
                      <YAxis tickLine={false} axisLine={false} stroke="var(--muted-foreground)" fontSize={12}/>
                      <Tooltip cursor={{ fill: "var(--accent)" }} contentStyle={{ background: "var(--popover)", border: "1px solid var(--border)", borderRadius: 14 }} formatter={(v) => money(Number(v))}/>
                      <Bar dataKey="amount" fill="var(--primary)" radius={[14,14,14,14]} />
                    </BarChart>
                  </ResponsiveContainer>
                </div>
              </Panel>

              <Panel title="Category budgets" action={<BudgetDialog month={month} onSaved={load}/>}>
                <div className="space-y-4">
                  {statuses.length === 0 ? <Empty text="Set a monthly limit to receive overspending warnings." /> : statuses.map((s) => {
                    const I = iconFor(s.category);
                    return (
                      <div key={s.category}>
                        <div className="mb-2 flex items-center gap-3">
                          <span className="icon-mini"><I/></span>
                          <div className="flex-1">
                            <b className="text-sm">{s.category}</b>
                            <p className="text-xs text-muted-foreground">{money(s.spent)} of {money(s.limit)}</p>
                          </div>
                          <span className={s.exceeded ? "text-xs font-semibold text-destructive" : s.warning ? "text-xs font-semibold text-warning" : "text-xs text-muted-foreground"}>
                            {Math.round(s.ratio * 100)}%
                          </span>
                        </div>
                        <div className="h-2 overflow-hidden rounded-full bg-muted">
                          <div className={s.exceeded ? "h-full bg-destructive" : s.warning ? "h-full bg-warning" : "h-full bg-primary"} style={{ width: `${Math.min(s.ratio*100,100)}%` }}></div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </Panel>
            </div>

            <Panel className="mt-6" title="Transactions" action={
              <div className="flex gap-1 rounded-full bg-muted p-1">
                {(["all","expense","income"] as const).map(k => (
                  <button key={k} onClick={() => setFilter(k)} className={filter===k ? "rounded-full bg-primary px-3 py-1 text-xs text-primary-foreground" : "px-3 py-1 text-xs text-muted-foreground"}>
                    {k === "all" ? "All" : k === "expense" ? "Expenses" : "Income"}
                  </button>
                ))}
              </div>
            }>
              <div className="divide-y divide-border">
                {shown.length === 0 ? <Empty text="No matching transactions yet." /> : shown.map((e) => {
                  const I = iconFor(e.category);
                  return (
                    <div key={e.id} className="flex items-center gap-4 py-4">
                      <span className="icon-mini"><I/></span>
                      <div className="min-w-0 flex-1">
                        <p className="truncate font-medium">{e.title}</p>
                        <p className="text-xs text-muted-foreground">{e.category} · {new Date(`${e.occurred_on}T12:00:00`).toLocaleDateString()}</p>
                      </div>
                      <b className={e.kind === "income" ? "text-success" : "text-foreground"}>{e.kind === "income" ? "+" : "−"}{money(Number(e.amount))}</b>
                      <Button size="icon" variant="ghost" aria-label={`Delete ${e.title}`} onClick={() => remove(e.id)}><Trash2/></Button>
                    </div>
                  );
                })}
              </div>
            </Panel>
          </section>
        </div>
      </div>
    </main>
  );
}

function TransactionDialog({ onSaved }: { onSaved: () => void }) {
  const [open, setOpen] = useState(false);
  const [kind, setKind] = useState("expense");
  const [category, setCategory] = useState("Food");

  async function submit(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    const f = new FormData(e.currentTarget);
    const { error } = await supabase.from("transactions").insert({
      title: String(f.get("title")),
      amount: Number(f.get("amount")),
      kind,
      category,
      occurred_on: String(f.get("date")),
      note: String(f.get("note") || "") || null,
    });
    if (error) toast.error("Could not save it.");
    else { toast.success("Transaction added."); setOpen(false); onSaved(); }
  }

  return (
    <Dialog open={open} onOpenChange={setOpen}>
      <DialogTrigger asChild><Button><Plus/>Add transaction</Button></DialogTrigger>
      <DialogContent>
        <DialogHeader>
          <DialogTitle>Add transaction</DialogTitle>
          <DialogDescription>Record spending or income for your dashboard.</DialogDescription>
        </DialogHeader>
        <form onSubmit={submit} className="grid gap-3">
          <div className="grid grid-cols-2 gap-2">
            {["expense","income"].map(k => (
              <Button type="button" key={k} variant={kind===k ? "default" : "outline"} onClick={() => { setKind(k); setCategory(k === "income" ? "Salary" : "Food"); }}>
                {k === "expense" ? "Expense" : "Income"}
              </Button>
            ))}
          </div>
          <Input required name="title" placeholder="Title, e.g. Grocery run"/>
          <Input required name="amount" type="number" min="0.01" step="0.01" placeholder="Amount"/>
          <select aria-label="Category" className="h-9 rounded-md border border-input bg-background px-3 text-sm" value={category} onChange={(e) => setCategory(e.target.value)}>
            {categories.map(c => <option key={c.name}>{c.name}</option>)}
          </select>
          <Input required name="date" type="date" defaultValue={new Date().toISOString().slice(0,10)}/>
          <Input name="note" placeholder="Note (optional)"/>
          <Button>Save transaction</Button>
        </form>
      </DialogContent>
    </Dialog>
  );
}

function BudgetDialog({ month, onSaved }: { month: string; onSaved: () => void }) {
  const [open, setOpen] = useState(false);

  async function submit(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    const f = new FormData(e.currentTarget);
    const { error } = await supabase.from("budgets").upsert({
      category: String(f.get("category")),
      monthly_limit: Number(f.get("limit")),
      month: `${month}-01`,
    }, { onConflict: "user_id,category,month" });
    if (error) toast.error("Could not save the budget.");
    else { toast.success("Budget saved."); setOpen(false); onSaved(); }
  }

  return (
    <Dialog open={open} onOpenChange={setOpen}>
      <DialogTrigger asChild><Button size="sm" variant="outline"><Target/>Set budget</Button></DialogTrigger>
      <DialogContent>
        <DialogHeader>
          <DialogTitle>Set category budget</DialogTitle>
          <DialogDescription>You’ll see a warning when spending reaches 80% of this limit.</DialogDescription>
        </DialogHeader>
        <form onSubmit={submit} className="grid gap-3">
          <select name="category" aria-label="Budget category" className="h-9 rounded-md border border-input bg-background px-3 text-sm">
            {categories.filter(c=>c.name!=="Salary").map(c => <option key={c.name}>{c.name}</option>)}
          </select>
          <Input required name="limit" type="number" min="1" step="0.01" placeholder="Monthly limit"/>
          <Button>Save budget</Button>
        </form>
      </DialogContent>
    </Dialog>
  );
}

