const categories = [
  { name: "Food", icon: Coffee }, { name: "Home", icon: House }, { name: "Transport", icon: Car },
  { name: "Shopping", icon: ShoppingBag }, { name: "Health", icon: HeartPulse }, { name: "Fun", icon: Gamepad2 },
  { name: "Bills", icon: Zap }, { name: "Salary", icon: BadgeDollarSign },
];
const iconFor = (name: string) => categories.find((item) => item.name === name)?.icon ?? CircleDollarSign;
const money = (value: number) => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(value);
const currentMonth = () => new Date().toISOString().slice(0, 7);

function Index() {
  const [session, setSession] = useState<Session | null>(null);
  const [ready, setReady] = useState(false);
  useEffect(() => {
    supabase.auth.getSession().then(({ data }) => { setSession(data.session); setReady(true); });
    const { data } = supabase.auth.onAuthStateChange((_event, next) => setSession(next));
    return () => data.subscription.unsubscribe();
  }, []);
  if (!ready) return <div className="grid min-h-screen place-items-center bg-background text-muted-foreground">Loading your money space…</div>;
  return session ? <Dashboard session={session} /> : <Landing />;
}

