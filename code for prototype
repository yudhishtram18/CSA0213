export type Entry = {
  id: string;
  title: string;
  amount: number;
  kind: string;
  category: string;
  occurred_on: string;
  note?: string | null;
};

export type CategoryBudget = {
  id?: string;
  category: string;
  monthly_limit: number;
};

export function sumKind(entries: Entry[], kind: "expense" | "income") {
  return entries.reduce((sum, entry) => sum + (entry.kind === kind ? Number(entry.amount) : 0), 0);
}

export function getBudgetStatus(entries: Entry[], budget: CategoryBudget) {
  const spent = entries.reduce(
    (sum, entry) =>
      sum + (entry.kind === "expense" && entry.category === budget.category ? Number(entry.amount) : 0),
    0,
  );
  const limit = Number(budget.monthly_limit);
  const ratio = limit > 0 ? spent / limit : 0;

  return {
    spent,
    limit,
    ratio,
    remaining: Math.max(limit - spent, 0),
    warning: ratio >= 0.8,
    exceeded: spent > limit,
  };
}

export function getDailySpending(entries: Entry[], month: string) {
  const [year = 1970, monthNumber = 1] = month.split("-").map(Number);
  const days = new Date(year, monthNumber, 0).getDate();
  const totals = Array.from({ length: days }, (_, index) => ({ day: index + 1, amount: 0 }));

  entries.forEach((entry) => {
    if (entry.kind !== "expense" || !entry.occurred_on.startsWith(month)) return;
    const day = Number(entry.occurred_on.slice(8, 10));
    const record = totals[day - 1];
    if (record) record.amount += Number(entry.amount);
  });

  return totals;
}
